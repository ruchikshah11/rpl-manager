<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Rpl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- RPL colours (from the logo) -->
            <Color x:Key="RplMaroon">#6B0F1A</Color>
            <Color x:Key="RplGold">#D4A64A</Color>
            <SolidColorBrush x:Key="RplMaroonBrush" Color="{StaticResource RplMaroon}" />
            <SolidColorBrush x:Key="RplGoldBrush" Color="{StaticResource RplGold}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
