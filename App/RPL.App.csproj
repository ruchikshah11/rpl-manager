<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rpl</RootNamespace>
    <AssemblyName>RPLManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\RPL.ico</ApplicationIcon>
    <Version>1.0</Version>
    <Product>RPL Manager</Product>
    <Description>Ratnadeep Premier League: players, teams, fixtures, results, awards and accounts for each season.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WinUI 3, unpackaged, Windows App SDK runtime bundled with the app -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The RPL logo ("PREMIER" spelling corrected), the batsman artwork for the registration form, and the program icon made from the logo -->
    <Content Include="..\Assets\RPL_Logo_classic.png" Link="Assets\RPL_Logo_classic.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Cricket_512.png" Link="Assets\Cricket_512.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\RPL.ico" Link="Assets\RPL.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Excel export fills this template, so Excel itself does the totals and the points table -->
    <Content Include="..\Templates\RPL_Template.xltx" Link="Templates\RPL_Template.xltx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
